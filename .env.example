# Copy this file to .env and fill in your values locally.
# Never commit .env to GitHub.

# Required for Google Gemini Live
GEMINI_API_KEY=

# Optional Argus license service. The API domain is pending operator setup.
#ARGUS_LICENSE_API_URL="https://YOUR_PROJECT.supabase.co/functions/v1/license"
#ARGUS_LICENSE_RENEW_URL="https://argusdev.netlify.app/planos/"

# Optional: choose from SUPPORTED_VOICE_NAMES in main.py (case-insensitive)
# Example: puck, charon, kore, fenrir, aoede, leda, orus, schedar, zubenelgenubi
GEMINI_VOICE_NAME="puck"

# Optional Gmail Desktop OAuth client JSON. Gmail uses browser OAuth, never an API key.
#GMAIL_OAUTH_CLIENT_FILE="/absolute/path/to/client_secret_....json"

# Optional presentation model overrides
#PRESENTATION_QA_MODEL="gemini-2.5-flash"
#GEMINI_IMAGE_MODEL="gemini-3.1-flash-image"

# Optional: trial/keyword runtime limit
# If ARGUS_TRIAL_KEYWORD is set to any non-empty string,
# Argus will run for ARGUS_RUNTIME_SECONDS (default: 3600).
#ARGUS_TRIAL_KEYWORD="trial"
#ARGUS_RUNTIME_SECONDS="3600"

# Optional: locked container requirements
#ARGUS_LOCKED_KEY_SECRET="expected_unlock_key_contents"
#ARGUS_LOCKED_VOLUME="NameOfVolumeUnderVolumes"

# Optional: for the local API (if you enable api.server)
#ARGUS_API_KEY="YOUR_PRIVATE_API_KEY"

# Hosted API (FastAPI + Postgres + Redis)
#DATABASE_URL="postgresql://argus:password@localhost:5432/argus"
#REDIS_URL="redis://localhost:6379/0"
#JWT_SECRET="generate-a-long-random-value"
#ARGUS_ENCRYPTION_KEY="generate-a-separate-long-random-value"
#CORS_ORIGINS="http://localhost:3000"
#ARGUS_ENV="development"
#AUTO_CREATE_TABLES="1"
#REDIS_REQUIRED="0"
#ACCESS_TOKEN_MINUTES="1440"
#ARGUS_CHAT_MODEL="gemini-2.5-flash"
